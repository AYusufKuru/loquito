# Uygulama
NODE_ENV=development

# ─── Veritabanı (Supabase PostgreSQL) ─────────────────────────────
# Vercel / canlı: Connection pooling (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=10&connection_limit=1"

# Migration ve prisma db push için doğrudan bağlantı (Session mode, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Lokal geliştirme (Supabase veya yerel PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loquito"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/loquito"

# Veritabanı komutları
# npm run db:setup    — şema + seed
# npm run db:studio   — görsel tarayıcı

# Oturum — en az 32 karakter, rastgele üretin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ─── Dosya depolama ───────────────────────────────────────────────
# Lokal: ./storage klasörü (Supabase değişkenleri boş bırakılabilir)
STORAGE_PATH="./storage"

# Canlı (Vercel): Supabase Storage — Project Settings → API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="loquito"

# Uygulama URL (Gmail OAuth geri dönüşü)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail entegrasyonu
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# Yapay zekâ API
# AI_API_KEY=
