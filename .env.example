# Uygulama
NODE_ENV=development

# Veritabanı — yol prisma/schema.prisma konumuna göre çözülür
DATABASE_URL="file:./dev.db"

# Veritabanı komutları
# npm run db:setup    — şema + seed
# npm run db:studio   — görsel tarayıcı

# Oturum — en az 32 karakter, rastgele üretin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Dosya depolama
STORAGE_PATH="./storage"

# Uygulama URL (Gmail OAuth geri dönüşü)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail entegrasyonu (Adım 27)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# Yapay zekâ API (Adım 26+ için)
# AI_API_KEY=
